# 复制为 .env 后修改。所有键的前缀都是 GESSELLSCHAFT_
# 修改后必须重启 uvicorn 才生效

# 对外访问地址(必须与 GitHub OAuth App 里登记的回调域名一致)
# 本地开发保持默认;生产改为 https://gesellschaft.allenlee.xyz
GESSELLSCHAFT_PUBLIC_BASE_URL=http://127.0.0.1:8787

# GitHub OAuth App 凭证(不配则登录功能不可用,其余功能正常)
GESSELLSCHAFT_OAUTH_CLIENT_ID=
GESSELLSCHAFT_OAUTH_CLIENT_SECRET=

# 访问 GitHub API 的代理(可选)。服务器在受限网络时设置,如 http://127.0.0.1:7890
# 仅作用于服务端的 code 交换与用户信息拉取;浏览器授权页仍由浏览器自身代理处理
GESSELLSCHAFT_GITHUB_PROXY=

# 管理页 /admin 登录令牌(默认 dev-admin-token,生产必须换掉)
GESSELLSCHAFT_ADMIN_TOKEN=dev-admin-token

# SQLite 数据库文件路径(相对启动目录,建议写绝对路径)
GESSELLSCHAFT_DB=data/gesellschaft.db

# HMAC 密钥(签发账号 Token / 会话 Cookie)。
# 留空 = 首次启动自动生成并写入 data/secret.key —— 不要删除该文件,
# 否则所有已登录 Token 与会话全部失效。生产建议直接显式配置。
GESSELLSCHAFT_SECRET_KEY=

# 限流(可选):默认 写操作 30次/3600秒,发布 10次/86400秒
# GESSELLSCHAFT_AGENT_WRITE_LIMIT=30
# GESSELLSCHAFT_AGENT_WRITE_WINDOW=3600
# GESSELLSCHAFT_PUBLISH_LIMIT=10
# GESSELLSCHAFT_PUBLISH_WINDOW=86400
